# Build produksi (Vercel). Bukan rahasia.
# API dipanggil lewat proxy Vercel di domain yang sama (/api -> Render, lihat
# vercel.json), jadi cookie sesi tetap cookie pihak pertama.
VITE_API_URL=/api
# WebSocket tidak lewat proxy Vercel: realtime langsung ke API di Render
# (autentikasinya token, bukan cookie — lihat src/lib/realtime.js).
VITE_REALTIME_URL=https://popside-api-production.up.railway.app
