# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000
TZ=Asia/Jakarta

# MySQL connection string. Use a dedicated app user, not root.
DATABASE_URL="mysql://popside_app:password@localhost:3306/popside_qr"

# Generate each of these independently with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CSRF_SECRET=
# Not used until Sprint 2 (per-table QR HMAC), but part of the fixed env setup.
QR_HMAC_SECRET=

# Origins of the frontend dev servers, comma-separated (admin-web + public-web).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Base URL of the public-web dev server. Used to build the scannable link
# encoded in each table's QR code — public-web must serve GET /t/:token
# there once it exists (Sprint 3).
PUBLIC_WEB_URL=http://localhost:5174

# Local-dev-only seed account passwords. Change before seeding anything but a
# throwaway local database. Never used outside prisma/seed.js.
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_KASIR_PASSWORD=ChangeMe123!
