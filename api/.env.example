# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000
TZ=Asia/Jakarta

# MySQL connection string. Use a dedicated app user, not root — and grant it
# only SELECT, INSERT, UPDATE, DELETE (see AGENTS.md "Database Lokal"), so
# even an injection bug can never DROP or ALTER a table.
# 127.0.0.1 rather than localhost: MySQL is bound to IPv4 loopback only, and
# on Windows "localhost" can resolve to IPv6 ::1 first.
DATABASE_URL="mysql://popside_app:password@127.0.0.1:3306/popside_qr"

# Migration-only account (CREATE/ALTER/DROP on popside_qr). Prisma Migrate
# picks this up automatically through `directUrl` in schema.prisma; the
# running app never touches it.
DIRECT_URL="mysql://popside_migrate:password@127.0.0.1:3306/popside_qr"

# Generate each of these independently with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CSRF_SECRET=
# Bagian dari setup env tetap (AGENTS.md), tapi kode saat ini tidak
# memakainya: token QR memakai secret unik per meja (tables.token_secret).
QR_HMAC_SECRET=

# Kunci enkripsi data (src/utils/kripto.js) — WAJIB, API menolak start tanpa
# keduanya. Masing-masing 32 byte base64, dan harus BERBEDA:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENC_KEY  mengenkripsi nomor HP member/reservasi dan rahasia 2FA admin.
# DATA_HASH_KEY membuat sidik pencarian nomor HP, cookie perangkat, kode OTP.
# Kunci HILANG = data itu tidak bisa dibaca lagi selamanya. Simpan salinannya
# di tempat aman, TERPISAH dari backup database (backup + kunci di tempat yang
# sama = enkripsinya tidak melindungi apa-apa).
DATA_ENC_KEY=
DATA_HASH_KEY=

# Origins of the frontend dev servers, comma-separated (admin-web + public-web).
# Include both localhost and 127.0.0.1 — browsers treat them as different
# origins even though they resolve to the same machine, so a browser opened
# with the "wrong" one gets silently blocked by CORS otherwise.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Base URL of the public-web dev server. Used to build the scannable link
# encoded in each table's QR code (public-web serves GET /t/:token).
PUBLIC_WEB_URL=http://localhost:5174

# Akun staff TIDAK diambil dari file ini. Akun admin pertama dibuat lewat
# `npm run create-admin`, yang menanyakan username & password langsung di
# terminal — passwordnya tidak pernah ditulis ke file mana pun, termasuk
# .env. Akun berikutnya dibuat dari halaman Akun Staff di Admin Web.

# Isi HANYA kalau API berjalan di belakang reverse proxy (nginx, Cloudflare,
# dll): jumlah hop proxy, biasanya 1. Tanpa proxy biarkan kosong — kalau
# diisi, klien bisa memalsukan X-Forwarded-For dan lolos dari rate limit.
# Hosting demo (Vercel -> Render) memakai 2, diatur di render.yaml.
TRUST_PROXY=

# Tempat file upload (foto menu, QRIS, bukti bayar) disimpan:
#   disk      (bawaan) folder api/uploads/
#   database  tabel berkas_upload — untuk hosting yang disknya tidak
#             permanen (Render gratis menghapus disk tiap restart/deploy).
# Aturan upload sama persis di kedua mode (src/lib/imageStore.js).
UPLOAD_DRIVER=disk

# OTP member: diskon member di checkout publik baru berlaku setelah nomor
# diverifikasi kode 6 digit (src/utils/pengirimOtp.js).
#   console  kode hanya ditulis ke log API — pengembangan saja. Di
#            NODE_ENV=production mode ini MATI: checkout tidak menawarkan
#            verifikasi, diskon member lewat kasir (Pesanan Manual).
#   http     kirim lewat gateway WhatsApp/SMS (isi OTP_HTTP_* di bawah).
OTP_PENGIRIM=console
# OTP_HTTP_URL=https://api.gateway-anda.example/send
# OTP_HTTP_TOKEN=
# OTP_HTTP_HEADER=Authorization
# OTP_HTTP_FORMAT=form
# OTP_HTTP_FIELD_NOMOR=target
# OTP_HTTP_FIELD_PESAN=message
# OTP_NOMOR_AWALAN=62
# Batas kode terkirim per hari untuk seluruh toko (menjaga biaya gateway).
# OTP_BATAS_HARIAN=200

# Tingkat log pino (bawaan: info).
# LOG_LEVEL=info
