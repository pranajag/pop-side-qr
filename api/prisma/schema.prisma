generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  waiting_verif
  confirmed
  cooking
  ready
  completed
  cancelled
}

enum PaymentMethod {
  qris
  tunai
  debit
}

enum UserRole {
  admin
  kasir
}

enum StaffCallStatus {
  pending
  resolved
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
  completed
}

model Table {
  id                    Int           @id @default(autoincrement())
  nomorMeja             String        @unique @map("nomor_meja")
  qrToken               String        @unique @map("qr_token")
  tokenSecret           String        @map("token_secret")
  isActive              Boolean       @default(true) @map("is_active")
  // Seats at this table — lets the reservation feature tell whether a table
  // actually fits an event's guest count. Defaults to 4 (a common table
  // size) so existing rows get a sane value on migration, not a forced
  // null-check everywhere capacity is read.
  kapasitas             Int           @default(4)
  // Start of the current "visit" — bumped by order.service.js right before
  // a new order is created for this table whenever the table had zero
  // non-terminal orders at that moment (i.e. genuinely free beforehand).
  // Null for a table that's never had that check run since this field was
  // added. Exists purely so getTableBill can tell "this group's orders"
  // apart from an earlier group's at the same physical table earlier today.
  currentVisitStartedAt DateTime?     @map("current_visit_started_at")
  // Staff-set marker for "this table hasn't been asked to pay yet" — pure
  // floor-status signal for DashboardView.vue, no effect on how orders or
  // payments actually work (each round still confirms/pays the same way it
  // always has). Auto-reset to false by order.service.js's
  // bumpVisitIfTableIsFree whenever a genuinely new visit starts, so it
  // can't accidentally carry over and mislabel a later, unrelated party's
  // table as still "open" from a previous group staff forgot to close.
  isBillOpen            Boolean       @default(false) @map("is_bill_open")
  orders                Order[]
  staffCalls            StaffCall[]
  reservations          Reservation[]

  @@map("tables")
}

// A customer's "need help" tap — no order attached, since it's often
// unrelated to any specific order (water refill, cutlery, a question).
model StaffCall {
  id             Int             @id @default(autoincrement())
  tableId        Int             @map("table_id")
  table          Table           @relation(fields: [tableId], references: [id])
  catatan        String?
  status         StaffCallStatus @default(pending)
  createdAt      DateTime        @default(now()) @map("created_at")
  resolvedAt     DateTime?       @map("resolved_at")
  resolvedBy     Int?            @map("resolved_by")
  resolvedByUser User?           @relation(fields: [resolvedBy], references: [id])

  @@index([status])
  @@index([tableId])
  @@map("staff_calls")
}

// Booking for a future event/occasion (birthday, gathering, meeting) — kept
// separate from Order since a reservation exists before any ordering
// happens, and many are taken over the phone with no order at all yet.
// tableId is nullable: staff can log a reservation before deciding which
// table to assign, then assign one later while checking it against that
// table's kapasitas.
model Reservation {
  id               Int               @id @default(autoincrement())
  namaCustomer     String            @map("nama_customer")
  namaAcara        String?           @map("nama_acara")
  telepon          String?
  jumlahTamu       Int               @map("jumlah_tamu")
  tanggalReservasi DateTime          @map("tanggal_reservasi")
  tableId          Int?              @map("table_id")
  // Restrict, not SetNull — same reasoning as Order.table: a table with
  // real reservation history must block deletion (table.service.js's
  // isForeignKeyError catch), not silently orphan the booking.
  table            Table?            @relation(fields: [tableId], references: [id], onDelete: Restrict)
  status           ReservationStatus @default(pending)
  catatan          String?
  // Deposit/DP to secure the booking — separate from the food bill the
  // guest's table racks up once they actually arrive and order (that still
  // goes through the normal per-order Payment flow, untouched by this).
  // 0/null depositAmount means no deposit required for this reservation,
  // which is every reservation before this feature existed and stays the
  // default for a new one unless staff sets one.
  depositAmount    Decimal?          @default(0) @map("deposit_amount")
  depositPaid      Boolean           @default(false) @map("deposit_paid")
  // Staff-recorded, not customer-self-service — there's no public booking
  // flow for reservations at all (ReservationsView.vue is the only place
  // one is ever created), so unlike Order there's no QRIS-proof-upload
  // step here; a staff member just marks it paid after collecting it
  // in whatever form actually happened (cash in hand, a transfer they
  // saw land, etc).
  depositMetode    PaymentMethod?    @map("deposit_metode")
  depositPaidAt    DateTime?         @map("deposit_paid_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([tanggalReservasi])
  @@index([tableId])
  @@map("reservations")
}

// Singleton row (always id=1) — store-wide settings that aren't specific
// to any product/category/table. Currently just the static QRIS image
// shown at checkout (MEMORY.md: one shared QRIS image for the whole
// store, not a per-transaction dynamic code).
model StoreSetting {
  id                  Int      @id @default(1)
  qrisImage           String?  @map("qris_image")
  // Receipt header + tax/service config. All optional/zero by default —
  // a store that never opens Pengaturan's new fields sees zero change from
  // before this existed: no store header line prints, no tax/service is
  // added to any total.
  namaToko            String?  @map("nama_toko")
  alamat              String?
  telepon             String?
  pajakPersen         Decimal  @default(0) @map("pajak_persen")
  serviceChargePersen Decimal  @default(0) @map("service_charge_persen")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

// External integrations (v1) — a small read-only API + outbound webhooks
// for a bookkeeping/inventory/etc tool to pull from or be pushed to. Only
// one tier of access exists for now: any live key can read every external
// endpoint, no per-key scoping — the honest v1 given nothing has needed
// finer-grained permissions yet.
model ApiKey {
  id         Int       @id @default(autoincrement())
  nama       String
  // SHA-256 of the actual key — never the key itself, same reasoning as a
  // password hash. The raw key is shown to the admin exactly once, at
  // creation (settings.controller.js), and never stored or retrievable
  // again after that.
  keyHash    String    @unique @map("key_hash")
  // Last few characters of the real key, kept only so the admin can tell
  // keys apart in the list ("...a91f") without the full value ever being
  // persisted or re-displayed.
  keySuffix  String    @map("key_suffix")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@map("api_keys")
}

// Outbound event subscription — order.service.js / orderManagement.service.js
// call webhook.service.js's dispatch() at the same points that already
// matter for everything else in this app (order created, status changed),
// fire-and-forget so a slow/dead receiving endpoint can never block or fail
// the actual staff/customer action that triggered it.
model Webhook {
  id        Int      @id @default(autoincrement())
  url       String
  // Comma-separated event names (order.created, order.status_changed) —
  // not a relation table, since the event vocabulary is tiny and fixed;
  // not worth a join for it.
  events    String
  // HMAC-SHA256 signing key for the X-Popside-Signature header, shown once
  // at creation like ApiKey.keyHash's raw value — this one IS stored
  // (unlike a password/API key) because dispatch() needs it on every
  // delivery to actually sign the payload, not just verify a claim.
  secret    String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("webhooks")
}

model Category {
  id            Int       @id @default(autoincrement())
  nama          String
  urutan        Int       @default(0)
  isActive      Boolean   @default(true) @map("is_active")
  // Rough, admin-set expectation ("Minuman ~5 menit") shown to the customer
  // on their order-status page — not derived from any real kitchen-timing
  // data (this system has none), so null just means "no estimate shown"
  // rather than defaulting to some made-up number.
  estimasiMenit Int?      @map("estimasi_menit")
  products      Product[]

  @@map("categories")
}

model Product {
  id            Int            @id @default(autoincrement())
  categoryId    Int            @map("category_id")
  category      Category       @relation(fields: [categoryId], references: [id])
  nama          String
  harga         Decimal
  // Cost price (HPP) — optional, purely for report.service.js's margin
  // calculation. Null (not 0) for a product nobody's entered this for yet,
  // so its margin reads as "unknown" on reports rather than silently
  // implying 100% profit.
  hargaModal    Decimal?       @map("harga_modal")
  stok          Int            @default(0)
  trackStock    Boolean        @default(false) @map("track_stock")
  foto          String?
  isAvailable   Boolean        @default(true) @map("is_available")
  orderItems    OrderItem[]
  variantGroups VariantGroup[]

  @@index([categoryId])
  @@map("products")
}

// Product-scoped, not shared across products — a cafe's "Level Gula" for
// one drink rarely needs to be the exact same option set as another, and
// sharing groups would need a much bigger many-to-many admin UI for a
// benefit this project doesn't need yet.
model VariantGroup {
  id        Int             @id @default(autoincrement())
  productId Int             @map("product_id")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  nama      String
  // required: customer must pick at least one option (e.g. Ukuran).
  // multiple: checkbox-style (Topping) vs single radio pick (Ukuran).
  required  Boolean         @default(false)
  multiple  Boolean         @default(false)
  urutan    Int             @default(0)
  options   VariantOption[]

  @@index([productId])
  @@map("variant_groups")
}

model VariantOption {
  id            Int          @id @default(autoincrement())
  groupId       Int          @map("group_id")
  group         VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  nama          String
  hargaTambahan Decimal      @default(0) @map("harga_tambahan")
  urutan        Int          @default(0)

  @@index([groupId])
  @@map("variant_options")
}

model Order {
  id                  Int              @id @default(autoincrement())
  kodeOrder           String           @unique @map("kode_order")
  // Null = not tied to a physical table — a manual counter/takeaway sale
  // punched in by staff (order.service.js:createManualOrder), which uses
  // customerName instead of a table number to identify the order.
  tableId             Int?             @map("table_id")
  // onDelete: Restrict (not Prisma's default SetNull for an optional
  // relation) — a table with real order history must still block deletion
  // via table.service.js's isForeignKeyError catch, exactly like before
  // this field became nullable. SetNull would silently orphan those rows,
  // making past dine-in orders look like manual/takeaway ones in reports.
  table               Table?           @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customerName        String?          @map("customer_name")
  // Loyalty program, staff-entered orders only (order.service.js's
  // createManualOrder — the public QR flow has no phone-collection step
  // yet, so this stays null for dine-in self-orders for now). Restrict, not
  // SetNull: a member's real purchase history must block deleting them,
  // never silently orphan the order onto no one.
  customerId          Int?             @map("customer_id")
  customer            Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Snapshot of points actually credited for this order, not recomputed
  // live from totalHarga — if the points-per-rupiah rate ever changes
  // later, a past order's own history must still say what it really
  // earned, and voiding it (orderManagement.service.js's updateStatus)
  // needs the exact amount to claw back, not a rate that may have moved on.
  pointsEarned        Int              @default(0) @map("points_earned")
  // Client-generated UUID, one per checkout attempt (order.service.js's
  // createOrder) — a retry after a dropped/timed-out response resends the
  // same key, so a second real HTTP request for the same tap resolves to
  // the order the first attempt actually created instead of a duplicate.
  // Null for manual/counter orders, which have no client retry to guard.
  idempotencyKey      String?          @unique @map("idempotency_key")
  status              OrderStatus      @default(pending)
  metode              PaymentMethod
  totalHarga          Decimal          @map("total_harga")
  // Retired at the store owner's explicit request — customers found the
  // odd extra rupiah on the QRIS amount confusing, easy to mistake for a
  // surcharge. No longer generated for new orders (order.service.js no
  // longer has pickUniqueCode); column kept, not dropped, purely so
  // historical orders created while this was active keep their real value
  // instead of losing data to a migration. Always null going forward.
  uniqueCode          Int?             @map("unique_code")
  // Manual discount, staff-entered orders only (order.service.js's
  // createManualOrder — never accepted from the public checkout, which
  // would let a customer set their own price). totalHarga above is already
  // net of this; discountAmount is kept only so a receipt/report can show
  // what was actually knocked off and why. 0/null for every order without
  // one, which is most of them.
  discountAmount      Decimal?         @default(0) @map("discount_amount")
  discountReason      String?          @map("discount_reason")
  // Snapshotted from StoreSetting's rates at the moment this order was
  // created (order.service.js's computeTaxAndService), never recomputed
  // later — a receipt must keep showing the rate that applied when the
  // sale happened even if the store's configured rate changes afterward.
  // Both are already folded into totalHarga below (that stays the one
  // source of truth every existing revenue/shift-cash/QRIS-code/webhook
  // calculation already keys off), kept separately only so a receipt can
  // show the subtotal -> tax -> service charge breakdown. 0 for every
  // order before this feature existed and for any store that never sets
  // a rate.
  taxAmount           Decimal          @default(0) @map("tax_amount")
  serviceChargeAmount Decimal          @default(0) @map("service_charge_amount")
  catatan             String?
  // Only ever set when cancelling an order that had already collected cash
  // (tunai, past `pending`) — lets a kasir log what they actually handed
  // back, instead of the cash-reconciliation view only ever guessing from
  // the order total. Null for every other order, forever.
  refundAmount        Decimal?         @map("refund_amount")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  items               OrderItem[]
  payment             Payment?
  statusLogs          OrderStatusLog[]

  @@index([status])
  @@index([createdAt])
  @@index([tableId])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id               Int                @id @default(autoincrement())
  orderId          Int                @map("order_id")
  order            Order              @relation(fields: [orderId], references: [id])
  productId        Int                @map("product_id")
  product          Product            @relation(fields: [productId], references: [id])
  qty              Int
  hargaSaatOrder   Decimal            @map("harga_saat_order")
  // Same reasoning as hargaSaatOrder: whether stock was actually decremented
  // for this line at order time must never be re-derived from the
  // product's *current* trackStock — an admin can flip that flag later,
  // which would otherwise make cancellation either restore stock that was
  // never taken, or skip restoring stock that was.
  stockDecremented Boolean            @default(false) @map("stock_decremented")
  catatan          String?
  variants         OrderItemVariant[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Snapshot only (namaGroup/namaOption/hargaTambahan copied at order time),
// no FK back to VariantOption — same reasoning as hargaSaatOrder: an admin
// can rename/delete/repricing a variant option later, and a past order must
// keep showing exactly what the customer picked and paid for, unaffected.
model OrderItemVariant {
  id            Int       @id @default(autoincrement())
  orderItemId   Int       @map("order_item_id")
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  namaGroup     String    @map("nama_group")
  namaOption    String    @map("nama_option")
  hargaTambahan Decimal   @map("harga_tambahan")

  @@index([orderItemId])
  @@map("order_item_variants")
}

model OrderStatusLog {
  id            Int         @id @default(autoincrement())
  orderId       Int         @map("order_id")
  order         Order       @relation(fields: [orderId], references: [id])
  statusFrom    OrderStatus @map("status_from")
  statusTo      OrderStatus @map("status_to")
  changedBy     Int?        @map("changed_by")
  changedByUser User?       @relation(fields: [changedBy], references: [id])
  catatan       String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_status_log")
}

model User {
  id           Int              @id @default(autoincrement())
  username     String           @unique
  passwordHash String           @map("password_hash")
  // Separate from passwordHash, same hashing scheme (bcrypt) — a short PIN
  // re-confirms "this is really you, right now" for one specific high-stakes
  // action (voiding an already-paid order) without making the whole staff
  // re-login. Null means no PIN set yet: orderManagement.service.js's
  // updateStatus refuses to void a paid order until one exists, rather than
  // silently skipping the check.
  pinHash      String?          @map("pin_hash")
  role         UserRole
  isActive     Boolean          @default(true) @map("is_active")
  statusLogs   OrderStatusLog[]
  payments     Payment[]
  staffCalls   StaffCall[]
  shifts       Shift[]

  @@map("users")
}

// Loyalty member, identified by phone number (matches how Moka POS's own
// membership works) — created on the fly the first time a manual order
// gives a phone number that isn't already a member, never through a
// separate signup step. points is a running balance credited at order
// creation and clawed back on a later void (order.service.js /
// orderManagement.service.js); redeeming them is a manual discount at
// checkout (ManualOrderView's existing diskon field with a "redeem N poin"
// reason) rather than a separate automated mechanism, at least for now.
model Customer {
  id        Int      @id @default(autoincrement())
  telepon   String   @unique
  nama      String?
  points    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orders    Order[]

  @@map("customers")
}

// Staff-configurable tiers for converting a member's accumulated points
// into an optional discount (staff-mediated redemption in Pesanan Manual —
// never self-service on public checkout, same reasoning as manual discount
// itself: customer.service.js's points are earned automatically, but
// spending them stays a staff decision). minPoints is the threshold a
// customer's balance must reach or exceed; the highest tier they qualify
// for wins (loyaltyTier.service.js's getApplicableTier). discountPercent is
// capped at 25 (validators/loyaltyTier.validator.js) — a safety ceiling on
// any single tier, not itself something this table stores or lets staff
// raise.
model LoyaltyTier {
  id              Int      @id @default(autoincrement())
  minPoints       Int      @unique @map("min_points")
  discountPercent Decimal  @map("discount_percent")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("loyalty_tiers")
}

// Clock-in/clock-out log for admin+kasir. Deliberately not linked to
// Order — shift "results" are computed on read by windowing Order.createdAt
// against [startedAt, endedAt ?? now()], the same REVENUE_STATUSES rule
// report.service.js already uses. Overlapping shifts (two staff on duty at
// once) legitimately double-count shared orders in both shifts' stats —
// this reports "what happened while I was clocked in", not per-order staff
// attribution, which this app has no concept of for QR/self-service orders.
model Shift {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  // Free-text, separate from the login account (User.username) — this cafe
  // can have several people rotating through one shared kasir/admin login,
  // so "who was actually on shift" needs its own answer distinct from
  // "which account confirmed the orders". Required going forward
  // (startShift, validators/shift.validator.js); null only for shifts
  // started before this field existed.
  namaStaff      String?   @map("nama_staff")
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  // Cash float the kasir puts in the drawer to start the shift (for making
  // change) — entered once, at startShift time, never editable after. Folded
  // into expectedCash so cashDifference reflects "ended with what it should
  // have, given what it started with" instead of silently assuming every
  // shift starts from zero. Null only for shifts started before this field
  // existed — never for a new one, startShift requires it.
  cashStart      Decimal?  @map("cash_start")
  // Physical cash the kasir counted in the drawer at shift end — entered
  // once, at endShift time, never editable after. Compared against
  // cashStart + tunai revenue for the shift window to catch a cash
  // shortfall ("minus").
  // Null until the shift is ended; shifts closed before this field existed
  // stay null forever (no reconciliation data to show for those).
  cashCounted    Decimal?  @map("cash_counted")
  // Manually entered at endShift time — sales from Gojek/GrabFood, an order
  // channel that never touches this system (no Order row, no cash drawer,
  // settled by the marketplace directly) but still real revenue for the
  // shift. Kept as two fields (not one lumped total) since the two
  // marketplaces settle with the cafe separately. Purely informational:
  // neither is ever factored into cashDifference/isMinus, since neither was
  // ever expected to be physical cash in the drawer.
  gojekAmount    Decimal?  @map("gojek_amount")
  grabfoodAmount Decimal?  @map("grabfood_amount")

  @@index([userId])
  @@index([startedAt])
  @@map("shifts")
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int           @unique @map("order_id")
  order          Order         @relation(fields: [orderId], references: [id])
  metode         PaymentMethod
  amount         Decimal
  // Cash handed over by the customer, recorded when a kasir confirms a
  // tunai payment — the change owed is amount subtracted from this, which
  // is the number staff actually needs at the counter. Null for every
  // non-cash order and for any cash order confirmed without entering it
  // (the field is optional, so a kasir in a hurry is never blocked).
  // Deliberately NOT folded into any revenue or cash-reconciliation sum:
  // the drawer still nets exactly `amount`, since the difference goes
  // straight back to the customer.
  cashReceived   Decimal?      @map("cash_received")
  buktiFile      String?       @map("bukti_file")
  verifiedBy     Int?          @map("verified_by")
  verifiedByUser User?         @relation(fields: [verifiedBy], references: [id])
  verifiedAt     DateTime?     @map("verified_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
}
