generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  waiting_verif
  confirmed
  cooking
  ready
  completed
  cancelled
}

enum PaymentMethod {
  qris
  tunai
  debit
}

enum UserRole {
  admin
  kasir
}

enum StaffCallStatus {
  pending
  resolved
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
  completed
}

model Table {
  id                    Int           @id @default(autoincrement())
  nomorMeja             String        @unique @map("nomor_meja")
  qrToken               String        @unique @map("qr_token")
  tokenSecret           String        @map("token_secret")
  isActive              Boolean       @default(true) @map("is_active")
  // Seats at this table — lets the reservation feature tell whether a table
  // actually fits an event's guest count. Defaults to 4 (a common table
  // size) so existing rows get a sane value on migration, not a forced
  // null-check everywhere capacity is read.
  kapasitas             Int           @default(4)
  // Start of the current "visit" — bumped by order.service.js right before
  // a new order is created for this table whenever the table had zero
  // non-terminal orders at that moment (i.e. genuinely free beforehand).
  // Null for a table that's never had that check run since this field was
  // added. Exists purely so getTableBill can tell "this group's orders"
  // apart from an earlier group's at the same physical table earlier today.
  currentVisitStartedAt DateTime?     @map("current_visit_started_at")
  orders                Order[]
  staffCalls            StaffCall[]
  reservations          Reservation[]

  @@map("tables")
}

// A customer's "need help" tap — no order attached, since it's often
// unrelated to any specific order (water refill, cutlery, a question).
model StaffCall {
  id             Int             @id @default(autoincrement())
  tableId        Int             @map("table_id")
  table          Table           @relation(fields: [tableId], references: [id])
  catatan        String?
  status         StaffCallStatus @default(pending)
  createdAt      DateTime        @default(now()) @map("created_at")
  resolvedAt     DateTime?       @map("resolved_at")
  resolvedBy     Int?            @map("resolved_by")
  resolvedByUser User?           @relation(fields: [resolvedBy], references: [id])

  @@index([status])
  @@index([tableId])
  @@map("staff_calls")
}

// Booking for a future event/occasion (birthday, gathering, meeting) — kept
// separate from Order since a reservation exists before any ordering
// happens, and many are taken over the phone with no order at all yet.
// tableId is nullable: staff can log a reservation before deciding which
// table to assign, then assign one later while checking it against that
// table's kapasitas.
model Reservation {
  id               Int               @id @default(autoincrement())
  namaCustomer     String            @map("nama_customer")
  namaAcara        String?           @map("nama_acara")
  telepon          String?
  jumlahTamu       Int               @map("jumlah_tamu")
  tanggalReservasi DateTime          @map("tanggal_reservasi")
  tableId          Int?              @map("table_id")
  // Restrict, not SetNull — same reasoning as Order.table: a table with
  // real reservation history must block deletion (table.service.js's
  // isForeignKeyError catch), not silently orphan the booking.
  table            Table?            @relation(fields: [tableId], references: [id], onDelete: Restrict)
  status           ReservationStatus @default(pending)
  catatan          String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([tanggalReservasi])
  @@index([tableId])
  @@map("reservations")
}

// Singleton row (always id=1) — store-wide settings that aren't specific
// to any product/category/table. Currently just the static QRIS image
// shown at checkout (MEMORY.md: one shared QRIS image for the whole
// store, not a per-transaction dynamic code).
model StoreSetting {
  id        Int      @id @default(1)
  qrisImage String?  @map("qris_image")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model Category {
  id            Int       @id @default(autoincrement())
  nama          String
  urutan        Int       @default(0)
  isActive      Boolean   @default(true) @map("is_active")
  // Rough, admin-set expectation ("Minuman ~5 menit") shown to the customer
  // on their order-status page — not derived from any real kitchen-timing
  // data (this system has none), so null just means "no estimate shown"
  // rather than defaulting to some made-up number.
  estimasiMenit Int?      @map("estimasi_menit")
  products      Product[]

  @@map("categories")
}

model Product {
  id            Int            @id @default(autoincrement())
  categoryId    Int            @map("category_id")
  category      Category       @relation(fields: [categoryId], references: [id])
  nama          String
  harga         Decimal
  stok          Int            @default(0)
  trackStock    Boolean        @default(false) @map("track_stock")
  foto          String?
  isAvailable   Boolean        @default(true) @map("is_available")
  orderItems    OrderItem[]
  variantGroups VariantGroup[]

  @@index([categoryId])
  @@map("products")
}

// Product-scoped, not shared across products — a cafe's "Level Gula" for
// one drink rarely needs to be the exact same option set as another, and
// sharing groups would need a much bigger many-to-many admin UI for a
// benefit this project doesn't need yet.
model VariantGroup {
  id        Int             @id @default(autoincrement())
  productId Int             @map("product_id")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  nama      String
  // required: customer must pick at least one option (e.g. Ukuran).
  // multiple: checkbox-style (Topping) vs single radio pick (Ukuran).
  required  Boolean         @default(false)
  multiple  Boolean         @default(false)
  urutan    Int             @default(0)
  options   VariantOption[]

  @@index([productId])
  @@map("variant_groups")
}

model VariantOption {
  id            Int          @id @default(autoincrement())
  groupId       Int          @map("group_id")
  group         VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  nama          String
  hargaTambahan Decimal      @default(0) @map("harga_tambahan")
  urutan        Int          @default(0)

  @@index([groupId])
  @@map("variant_options")
}

model Order {
  id           Int              @id @default(autoincrement())
  kodeOrder    String           @unique @map("kode_order")
  // Null = not tied to a physical table — a manual counter/takeaway sale
  // punched in by staff (order.service.js:createManualOrder), which uses
  // customerName instead of a table number to identify the order.
  tableId      Int?             @map("table_id")
  // onDelete: Restrict (not Prisma's default SetNull for an optional
  // relation) — a table with real order history must still block deletion
  // via table.service.js's isForeignKeyError catch, exactly like before
  // this field became nullable. SetNull would silently orphan those rows,
  // making past dine-in orders look like manual/takeaway ones in reports.
  table        Table?           @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customerName String?          @map("customer_name")
  status       OrderStatus      @default(pending)
  metode       PaymentMethod
  totalHarga   Decimal          @map("total_harga")
  catatan      String?
  // Only ever set when cancelling an order that had already collected cash
  // (tunai, past `pending`) — lets a kasir log what they actually handed
  // back, instead of the cash-reconciliation view only ever guessing from
  // the order total. Null for every other order, forever.
  refundAmount Decimal?         @map("refund_amount")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  items        OrderItem[]
  payment      Payment?
  statusLogs   OrderStatusLog[]

  @@index([status])
  @@index([createdAt])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id               Int                @id @default(autoincrement())
  orderId          Int                @map("order_id")
  order            Order              @relation(fields: [orderId], references: [id])
  productId        Int                @map("product_id")
  product          Product            @relation(fields: [productId], references: [id])
  qty              Int
  hargaSaatOrder   Decimal            @map("harga_saat_order")
  // Same reasoning as hargaSaatOrder: whether stock was actually decremented
  // for this line at order time must never be re-derived from the
  // product's *current* trackStock — an admin can flip that flag later,
  // which would otherwise make cancellation either restore stock that was
  // never taken, or skip restoring stock that was.
  stockDecremented Boolean            @default(false) @map("stock_decremented")
  catatan          String?
  variants         OrderItemVariant[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Snapshot only (namaGroup/namaOption/hargaTambahan copied at order time),
// no FK back to VariantOption — same reasoning as hargaSaatOrder: an admin
// can rename/delete/repricing a variant option later, and a past order must
// keep showing exactly what the customer picked and paid for, unaffected.
model OrderItemVariant {
  id            Int       @id @default(autoincrement())
  orderItemId   Int       @map("order_item_id")
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  namaGroup     String    @map("nama_group")
  namaOption    String    @map("nama_option")
  hargaTambahan Decimal   @map("harga_tambahan")

  @@index([orderItemId])
  @@map("order_item_variants")
}

model OrderStatusLog {
  id            Int         @id @default(autoincrement())
  orderId       Int         @map("order_id")
  order         Order       @relation(fields: [orderId], references: [id])
  statusFrom    OrderStatus @map("status_from")
  statusTo      OrderStatus @map("status_to")
  changedBy     Int?        @map("changed_by")
  changedByUser User?       @relation(fields: [changedBy], references: [id])
  catatan       String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_status_log")
}

model User {
  id           Int              @id @default(autoincrement())
  username     String           @unique
  passwordHash String           @map("password_hash")
  role         UserRole
  isActive     Boolean          @default(true) @map("is_active")
  statusLogs   OrderStatusLog[]
  payments     Payment[]
  staffCalls   StaffCall[]
  shifts       Shift[]

  @@map("users")
}

// Clock-in/clock-out log for admin+kasir. Deliberately not linked to
// Order — shift "results" are computed on read by windowing Order.createdAt
// against [startedAt, endedAt ?? now()], the same REVENUE_STATUSES rule
// report.service.js already uses. Overlapping shifts (two staff on duty at
// once) legitimately double-count shared orders in both shifts' stats —
// this reports "what happened while I was clocked in", not per-order staff
// attribution, which this app has no concept of for QR/self-service orders.
model Shift {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  user              User      @relation(fields: [userId], references: [id])
  startedAt         DateTime  @default(now()) @map("started_at")
  endedAt           DateTime? @map("ended_at")
  // Cash float the kasir puts in the drawer to start the shift (for making
  // change) — entered once, at startShift time, never editable after. Folded
  // into expectedCash so cashDifference reflects "ended with what it should
  // have, given what it started with" instead of silently assuming every
  // shift starts from zero. Null only for shifts started before this field
  // existed — never for a new one, startShift requires it.
  cashStart         Decimal?  @map("cash_start")
  // Physical cash the kasir counted in the drawer at shift end — entered
  // once, at endShift time, never editable after. Compared against
  // cashStart + tunai revenue for the shift window to catch a cash
  // shortfall ("minus").
  // Null until the shift is ended; shifts closed before this field existed
  // stay null forever (no reconciliation data to show for those).
  cashCounted       Decimal?  @map("cash_counted")
  // Manually entered at endShift time — sales from Gojek/GrabFood, an order
  // channel that never touches this system (no Order row, no cash drawer,
  // settled by the marketplace directly) but still real revenue for the
  // shift. Kept as two fields (not one lumped total) since the two
  // marketplaces settle with the cafe separately. Purely informational:
  // neither is ever factored into cashDifference/isMinus, since neither was
  // ever expected to be physical cash in the drawer.
  gojekAmount       Decimal?  @map("gojek_amount")
  grabfoodAmount    Decimal?  @map("grabfood_amount")

  @@index([userId])
  @@index([startedAt])
  @@map("shifts")
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int           @unique @map("order_id")
  order          Order         @relation(fields: [orderId], references: [id])
  metode         PaymentMethod
  amount         Decimal
  buktiFile      String?       @map("bukti_file")
  verifiedBy     Int?          @map("verified_by")
  verifiedByUser User?         @relation(fields: [verifiedBy], references: [id])
  verifiedAt     DateTime?     @map("verified_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
}
